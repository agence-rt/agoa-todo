{
  "name": "agoa-todo",
  "productName": "AGOA TD",
  "version": "0.2.1",
  "description": "AGOA TD — to do list des dossiers par personne (Rémi Thollet Architecte)",
  "author": "Rémi Thollet Architecte",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"tests/*.test.js\"",
    "icons": "node scripts/make-icons.js",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "jsdom": "25.0.1",
    "png-to-ico": "2.1.8",
    "sharp": "0.33.5"
  },
  "build": {
    "appId": "fr.remithollet.agoa-td",
    "productName": "AGOA TD",
    "copyright": "Rémi Thollet Architecte",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": ".",
        "filter": [
          "google-client.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGOA TD",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "agence-rt",
        "repo": "agoa-todo"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
